axes.prop_cycle : cycler('color', ['olivedrab', 'steelblue', 'firebrick', 'goldenrod'])

backend : pgf

figure.constrained_layout.use : True
figure.constrained_layout.w_pad : 0.09 
figure.constrained_layout.h_pad : 0.09

figure.dpi : 600
figure.figsize : 4.8 , 3.6

font.family : sans
font.size : 11

legend.fontsize : small
legend.frameon : False

lines.linewidth: 1

pgf.preamble : \input{design.tex}
pgf.rcfonts : False
pgf.texsystem : lualatex

text.usetex : True

xtick.labelsize : 9
xtick.minor.visible : True

ytick.labelsize : 9
ytick.minor.visible : True
